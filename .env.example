# ==============================================================================
# Enterprise Adaptive RAG, Agentic Orchestration & Research Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    - Windows: copy .env.example .env
#    - macOS/Linux: cp .env.example .env
# 2. Fill in the required API keys (GROQ_API_KEY, JWT_SECRET_KEY, etc.)
# 3. For local zero-cost testing, leave LLM_PROVIDER=groq (free tier) or LLM_PROVIDER=fake
# ==============================================================================

# --- Core Application Configuration ---
APP_NAME=production-rag-backend
ENV=dev
LOG_LEVEL=INFO

# --- Database Configuration (PostgreSQL with pgvector) ---
# Default assumes PostgreSQL running locally on port 5432 (or port 5433 if Docker mapped)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb

# --- Embedding Provider Configuration ---
# Supported providers: sentence_transformers | openai | fake
# - sentence_transformers: Local, free, runs on CPU/GPU (all-MiniLM-L6-v2, 384 dimensions)
# - openai: Cloud-based (text-embedding-3-small, 1536 dimensions)
# - fake: Mock embeddings for rapid unit/integration testing
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- LLM Provider Configuration ---
# Supported providers: groq | openai | gemini | fake
LLM_PROVIDER=groq

# 1. Groq (High-speed inference - Recommended for default development)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 2. OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# 3. Google Gemini (Optional)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Web Search & Deep Research Providers ---
# Supported providers: tinyfish | firecrawl | fake
ENABLE_WEB_RESEARCH=true
WEB_SEARCH_PROVIDER=tinyfish

# TinyFish Search & Scrape API Configuration
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# Firecrawl API Configuration (Optional alternative to TinyFish)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Web Research Budget & Scrape Limits
WEB_RESEARCH_TARGET_PAGES=2
WEB_RESEARCH_MAX_SCRAPES=4
WEB_RESEARCH_MAX_CANDIDATES_PER_DOMAIN=1

# --- Security, JWT & Encryption Keys ---
# CRITICAL: Generate a strong random key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=super_secure_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dedicated Fernet key for workspace credential encryption (MultiFernet rotation support)
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Default Seed Administrator Account
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=Admin@12345

# --- Inbound Webhooks & Trigger Automation (Twenty CRM & n8n) ---
# Shared secret for HMAC-SHA256 signature verification on inbound webhooks
TWENTY_WEBHOOK_SECRET=your_webhook_hmac_secret_key_here
TWENTY_WEBHOOK_MAX_BYTES=1048576

# Server-side mapping of Webhook IDs to internal workspace/department codes
# Format: JSON string mapping webhookId to department_id
TWENTY_WEBHOOK_MAPPINGS={"default-webhook-id":{"department_id":"SALES"}}

# Background Scheduler Loop Interval (in seconds)
SCHEDULER_INTERVAL_SECONDS=60

# --- Outbound MCP & Twenty CRM Integration ---
ENABLE_CRM_INTEGRATION=true
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
TWENTY_MCP_ENABLED=false
TWENTY_MCP_URL=http://localhost:3000/mcp

# --- RAG Retrieval & Hybrid Ranking Hyperparameters ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MAX_CHUNKS_PER_DOCUMENT=4
MIN_VECTOR_SIMILARITY=0.25
RETRIEVAL_CANDIDATE_K=20
RRF_K=60
VECTOR_SEARCH_WEIGHT=1.0
KEYWORD_SEARCH_WEIGHT=1.2
STRUCTURED_SEARCH_WEIGHT=2.0
HIERARCHICAL_SEARCH_WEIGHT=0.8
HIERARCHICAL_MAX_DESCENDANT_DEPTH=3

# --- Hierarchical Context Bounds (OpenViking L0/L1) ---
NODE_L0_MAX_CHARS=300
NODE_L1_MAX_CHARS=600

# --- Multi-Format Artifact Storage Settings ---
ARTIFACT_STORAGE_DIR=storage/artifacts
ARTIFACT_RETENTION_HOURS=48
ARTIFACT_MAX_BYTES=26214400
ARTIFACT_MAX_ROWS=500
